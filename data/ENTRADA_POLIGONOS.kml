  </div>

  <table cellpadding="6" cellspacing="0" style="width:100%; border-collapse:collapse; font-size:12px;">
    <tr style="background:#f4f1ea;">
      <td style="border:1px solid #C9B280; font-weight:bold; color:#5c574f;">Socio</td>
      <td style="border:1px solid #C9B280;">Cubico</td>
    </tr>
    <tr>
      <td style="border:1px solid #C9B280; font-weight:bold; color:#5c574f;">Tecnología</td>
