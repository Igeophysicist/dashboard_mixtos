					<Placemark id="5E5889D6A9000018">
						<name>San Pedro Solar [polígono 1]</name>
						<visibility>0</visibility>
						<description><![CDATA[<div style="font-family:Arial, Helvetica, sans-serif; width:340px; color:#2a2622;">

  <div style="background:#335955; padding:10px 12px;">
    <span style="color:#e6d194; font-size:10px; letter-spacing:1px;">FICHA TÉCNICA DEL PROYECTO</span><br>
    <span style="color:#ffffff; font-size:18px; font-weight:bold;">San Pedro Solar [polígono 1]</span>
  </div>

  <table cellpadding="6" cellspacing="0" style="width:100%; border-collapse:collapse; font-size:12px;">
    <tr style="background:#f4f1ea;">
      <td style="border:1px solid #C9B280; font-weight:bold; color:#5c574f;">Socio</td>
      <td style="border:1px solid #C9B280;">Elawan Wind Mexico III</td>
    </tr>
    <tr>
      <td style="border:1px solid #C9B280; font-weight:bold; color:#5c574f;">Tecnología</td>
      <td style="border:1px solid #C9B280;">FV - Fotovoltaica</td>
    </tr>
    <tr style="background:#f4f1ea;">
      <td style="border:1px solid #C9B280; font-weight:bold; color:#5c574f;">Ubicación</td>
      <td style="border:1px solid #C9B280;">Huimalpan, Querétaro</td>
    </tr>
    <tr>
      <td style="border:1px solid #C9B280; font-weight:bold; color:#5c574f;">Capacidad</td>
      <td style="border:1px solid #C9B280;">98.20 MW</td>
    </tr>
    <tr style="background:#f4f1ea;">
      <td style="border:1px solid #C9B280; font-weight:bold; color:#5c574f;">Almacenamiento (BESS)</td>
      <td style="border:1px solid #C9B280;">29.46 MW / 88.38 MWh</td>
    </tr>
    <tr>
      <td style="border:1px solid #C9B280; font-weight:bold; color:#5c574f;">Horas de Almacenamiento</td>
      <td style="border:1px solid #C9B280;">3.00 h</td>
    </tr>
    <tr style="background:#f4f1ea;">
      <td style="border:1px solid #C9B280; font-weight:bold; color:#5c574f;">Inicio de Construcción</td>
      <td style="border:1px solid #C9B280;">01 de marzo de 2027</td>
    </tr>
    <tr>
      <td style="border:1px solid #C9B280; font-weight:bold; color:#5c574f;">Fin de Construcción</td>
      <td style="border:1px solid #C9B280;">31 de marzo de 2028</td>
    </tr>
    <tr style="background:#f4f1ea;">
      <td style="border:1px solid #C9B280; font-weight:bold; color:#5c574f;">Firma de Contrato</td>
      <td style="border:1px solid #C9B280;">09 de julio de 2026</td>
    </tr>
      <td style="border:1px solid #C9B280; font-weight:bold; color:#5c574f;">CAPEX (USD)</td>
      <td style="border:1px solid #C9B280; font-weight:bold;">$90,724,532.90</td>
    </tr>
  </table>
<div style="width:340px; text-align:right; font-family:Arial, Helvetica, sans-serif; font-size:10px; color:#c0c0c0;
